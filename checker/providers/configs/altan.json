{
    "nombre": "Redes ALTÁN",
    "url": "https://rnu.altanredes.com/consulta",

    "steps": [
        {
            "action": "reach_down"
        },
        {
            "action": "fill",
            "type": "css",
            "selector": "input[placeholder='CURP']",
            "value": "{curp}"
        },
        {
            "action": "click",
            "type": "xpath",
            "selector": "//label[contains(., 'Acepto los Términos y Condiciones')]"
        },
        {
            "action": "click",
            "type": "xpath",
            "selector": "//label[contains(., 'Acepto el Aviso de Privacidad')]"
        },
        {
            "action": "click_shadow",
            "host": "cap-widget",
            "selector": ".captcha"
        },
        {
            "action": "click",
            "type": "xpath",
            "selector": "//button[normalize-space()='Buscar']"
        },
        {
            "action": "pause",
            "time": 0.8
        },
        {
            "action": "reach_down"
        }
    ],
     "results": {
        "positive": {
            "type": "xpath",
            "selector": "//p[contains(., 'Coincidencias encontradas')]"
        },
        "negative": {
            "type": "xpath",
            "selector": "//p[contains(., 'No se encontraron líneas')]"
        }
    }
}