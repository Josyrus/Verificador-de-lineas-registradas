{
    "nombre":"Dalefon/Internet para el Bienestar",
    "url":"https://www.internetbienestarmex.com/vinculatulinea",
    "steps":[
        {
            "action":"fill",
            "type":"css",
            "selector":"input[placeholder='CURP']",
            "value":"{curp}"
        },
        {
            "action":"click",
            "type":"xpath",
            "selector":"/html/body/div[3]/div[2]/div/div[1]/div[2]/div/div/button"
        }
    ],
    "results":{
        "positive":
        {
            "type":"xpath",
            "selector":"//span[contains(.,'Estas son las líneas')]"
        },
        "negative":{
            "type":"xpath",
            "selector":"//span[contains(.,'No cuentas con líneas')]"
        }
    }
}