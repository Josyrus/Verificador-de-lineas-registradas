{
    "nombre": "BuenoCell",
    "url": "https://buenocell.mx/consultalineas",
    "steps": [
        {
            "action": "fill",
            "type": "css",
            "selector": "input[autocapitalize='characters']",
            "value": "{curp}"
        },
        {
            "action": "wait_if_captcha",
            "type": "css",
            "selector": "button.primary[disabled]"
        },
        {
            "action": "pause",
            "time": 0.8
        },
        {
            "action": "click",
            "type": "xpath",
            "selector": "//button[contains(., 'Consultar')]"
        }
    ],
    "results": {
        "negative": {
            "type": "xpath",
            "selector": "//h1[contains(., 'No encontramos')]"
        },
        "positive": {
            "type": "xpath",
            "selector": "//span[contains(text(), '****')]"
        }
    }
}