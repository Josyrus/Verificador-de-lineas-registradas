{
    "nombre": "Mirlo",
    "url": "https://mirlo.com/vinculatulinea/consulta",
    "steps": [
        {
            "action": "fill",
            "type": "css",
            "selector": "#identifier",
            "value": "{curp}"
        },
        {
            "action": "click",
            "type": "xpath",
            "selector": "/html/body/div[2]/div[2]/div/div/form/button"
        }
    ],
    "results": {
        "negative": {
            "type": "xpath",
            "selector": "//h2[normalize-space(.)='No encontramos líneas con ese dato']"
        },
        "positive": {
            "type": "xpath",
            "selector": "//p[contains(normalize-space(.), 'líneas registradas')]"
        }
    }
}